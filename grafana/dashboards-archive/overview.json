          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT channel, state, threshold, round(value::numeric,3) AS value, t AS since FROM (  SELECT DISTINCT ON (channel) channel, state, threshold, value, t  FROM alarm_events ORDER BY channel, t DESC) latest WHERE state <> 'ok' ORDER BY   CASE state WHEN 'critical' THEN 0 WHEN 'major' THEN 1 ELSE 2 END, channel",
