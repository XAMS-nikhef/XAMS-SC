{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "One time series for one channel, picked with $channel. This is what the P&ID mimic (DESIGN.md section 8.2a) opens when a value is clicked, so it is the one dashboard every tag in channels.yaml shares rather than one dashboard per tag. uid xams-channel and panel id 1 are hardcoded in mimic.html; changing either here is a breaking change there. The series is named after the channel (channel AS metric) so that a field override can target one channel: sg101/sg102 are shown to 3 decimals, because they are read against the flow meter and 1 uA of loop current is 1.25 g. p105 (the PKR vacuum gauge, mbar over twelve decades) is drawn on a LOG axis by the same kind of override, so clicking P105 on the P&ID opens a readable plot. Every other channel keeps Grafana's automatic precision, and the P&ID mimic is unaffected - it formats its own numbers in mimic.html.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "xams-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "showValues": false,
            "spanNulls": 45000,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^sg10[12]$/"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "unit",
                "value": "suffix:kg"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p105"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pressurembar"
              },
              {
                "id": "custom.scaleDistribution",
                "value": {
                  "log": 10,
                  "type": "log"
                }
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "10s",
      "maxDataPoints": 3000,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "xams-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(t, $__interval), channel AS metric, avg(value) AS value FROM meas WHERE channel = '$channel' AND $__timeFilter(t) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "$channel",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "xams"
  ],
  "templating": {
